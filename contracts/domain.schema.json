{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "研学实操资源编排领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ACTIVITY_DECLARED",
        "STUDENT_FLAGGED",
        "GROUP_CONFIRMED",
        "RESOURCE_ALLOCATED",
        "RESOURCE_IN_TRANSIT",
        "SAFETY_OVERRIDE_SIGNED",
        "ACTIVITY_STARTED",
        "CONSUMABLE_CONSUMED",
        "ITINERARY_REVISED",
        "WAITLIST_PROMOTED",
        "EVIDENCE_ACCEPTED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "student_group",
        "activity_slot",
        "resource_unit",
        "learning_evidence"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
